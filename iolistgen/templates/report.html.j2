<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="iolistgen {{ ctx.version }}">
<title>{{ ctx.title }} · {{ ctx.file_name }}</title>
<style>
:root {
  color-scheme: light dark;
  --bg: #f4f6f9;
  --surface: #ffffff;
  --surface-2: #edf1f5;
  --grid: #e3e8ee;
  --border: #c9d3de;
  --text: #0f1923;
  --text-muted: #3d4b5c;
  --text-dim: #5b6b7e;
  --accent: #c2410c;
  --process: #1c6fb8;
  --ok: #1e8a5f;
  --ok-soft: #ddf2e8;
  --warn: #b7860b;
  --warn-soft: #faf0d2;
  --alarm: #c9302c;
  --alarm-soft: #fbe4e3;
  --font-sans: "Segoe UI", system-ui, -apple-system, "Roboto", "Helvetica Neue", Arial, sans-serif;
  --font-mono: "Cascadia Mono", "Cascadia Code", "JetBrains Mono", Consolas, "DejaVu Sans Mono", monospace;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #0e1621;
    --surface: #141e2b;
    --surface-2: #1b2736;
    --grid: #1f2c3d;
    --border: #2a3a4f;
    --text: #e6edf3;
    --text-muted: #a9b6c6;
    --text-dim: #7f90a6;
    --accent: #ff7a1a;
    --process: #4ea8de;
    --ok: #3fb68b;
    --ok-soft: #12302a;
    --warn: #f2c94c;
    --warn-soft: #3a3118;
    --alarm: #f0524f;
    --alarm-soft: #3b1b1f;
  }
}
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body { margin: 0; background: var(--bg); color: var(--text); font: 14px/1.5 var(--font-sans); }
.page { max-width: 1200px; margin: 0 auto; padding: 28px 24px 40px; }
.mono { font-family: var(--font-mono); font-size: 12.5px; }
header.top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px;
  padding-bottom: 18px; border-bottom: 1px solid var(--border); }
.brand { display: flex; align-items: center; gap: 14px; min-width: 0; }
.brand-mark { flex: none; width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center;
  background: var(--surface); border: 1px solid var(--border); color: var(--text-muted); }
.brand-mark .hl { color: var(--accent); }
.eyebrow { font-family: var(--font-mono); font-size: 12px; font-weight: 600; letter-spacing: .04em;
  color: var(--text-dim); text-transform: uppercase; }
h1 { margin: 2px 0 0; font-size: 22px; line-height: 1.25; font-weight: 600; letter-spacing: -.01em; }
.meta { display: grid; grid-template-columns: auto auto; gap: 2px 14px; font-size: 12.5px; color: var(--text-dim); }
.meta dt { margin: 0; }
.meta dd { margin: 0; color: var(--text-muted); overflow-wrap: anywhere; }
.verdict { margin-top: 22px; display: flex; align-items: center; gap: 16px; padding: 16px 20px; border-radius: 12px;
  background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--verdict); }
.verdict--fail { --verdict: var(--alarm); --verdict-soft: var(--alarm-soft); }
.verdict--ok { --verdict: var(--ok); --verdict-soft: var(--ok-soft); }
.verdict-icon { flex: none; width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center;
  background: var(--verdict-soft); color: var(--verdict); }
.verdict h2 { margin: 0; font-size: 18px; line-height: 1.3; font-weight: 600; }
.verdict p { margin: 2px 0 0; color: var(--text-muted); }
.kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; margin-top: 14px; }
.tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 13px 16px 14px; }
.tile-label { font-size: 12.5px; color: var(--text-dim); display: flex; align-items: center; gap: 6px; }
.tile-value { font-size: 30px; font-weight: 600; line-height: 1.15; margin-top: 4px; letter-spacing: -.01em; }
.tile-note { font-size: 12px; color: var(--text-dim); margin-top: 2px; }
.dot { width: 8px; height: 8px; border-radius: 50%; background: var(--dot, var(--text-dim)); }
.tile--alarm { --dot: var(--alarm); }
.tile--warn { --dot: var(--warn); }
.tile--ok { --dot: var(--ok); }
.composition { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 12.5px; color: var(--text-dim); }
.composition > div { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; }
.chip { display: inline-flex; gap: 6px; align-items: baseline; padding: 1px 8px; border-radius: 6px;
  background: var(--surface-2); color: var(--text-muted); font-family: var(--font-mono); font-size: 12px; }
.chip b { color: var(--text); font-weight: 600; }
.card { margin-top: 22px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; overflow: hidden; }
.card-head { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; justify-content: space-between;
  padding: 12px 16px; border-bottom: 1px solid var(--border); }
.card-head h2 { font-size: 15px; margin: 0; font-weight: 600; }
.card-head .count { color: var(--text-dim); font-weight: 400; margin-left: 6px; }
.tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
.filter { font: inherit; font-size: 12.5px; padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border);
  background: var(--surface); color: var(--text-muted); cursor: pointer; }
.filter:hover { border-color: var(--text-dim); }
.filter[aria-pressed="true"] { background: var(--text); border-color: var(--text); color: var(--surface); }
.filter:focus-visible, .search:focus-visible { outline: 2px solid var(--process); outline-offset: 1px; }
.search { font: inherit; font-size: 13px; padding: 4px 10px; border-radius: 6px; border: 1px solid var(--border);
  background: var(--bg); color: var(--text); width: 240px; max-width: 100%; }
.table-wrap { overflow-x: auto; }
table { width: 100%; border-collapse: collapse; }
th { text-align: left; font-size: 11.5px; font-weight: 600; color: var(--text-dim); text-transform: uppercase;
  letter-spacing: .04em; padding: 8px 14px; background: var(--surface-2); border-bottom: 1px solid var(--border);
  white-space: nowrap; }
td { padding: 11px 14px; border-bottom: 1px solid var(--grid); vertical-align: top; }
tbody tr:last-child td { border-bottom: 0; }
tbody tr:hover td { background: color-mix(in srgb, var(--surface-2) 55%, transparent); }
.num { text-align: right; font-variant-numeric: tabular-nums; }
.sev { display: inline-flex; align-items: center; gap: 6px; padding: 2px 9px 2px 6px; border-radius: 999px;
  font-size: 12px; font-weight: 600; white-space: nowrap; color: var(--text); }
.sev--error { background: var(--alarm-soft); }
.sev--error svg { color: var(--alarm); }
.sev--warning { background: var(--warn-soft); }
.sev--warning svg { color: var(--warn); }
.code { font-family: var(--font-mono); font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }
.where { font-size: 12.5px; color: var(--text-muted); white-space: nowrap; }
.where b { color: var(--text); font-weight: 600; font-variant-numeric: tabular-nums; }
.where .col { display: block; color: var(--text-dim); max-width: 22ch; overflow: hidden; text-overflow: ellipsis; }
.tag { font-family: var(--font-mono); font-size: 12.5px; white-space: nowrap; }
.tag .dev { display: block; color: var(--text-dim); font-size: 11.5px; }
.msg { color: var(--text); }
.fix { margin-top: 4px; color: var(--text-muted); font-size: 13px; }
.fix-label { color: var(--text-dim); font-size: 11.5px; font-weight: 600; text-transform: uppercase;
  letter-spacing: .04em; margin-right: 6px; }
.rel { margin-top: 3px; color: var(--text-dim); font-size: 12px; }
.empty { padding: 36px 16px; text-align: center; color: var(--text-muted); }
.empty svg { color: var(--ok); }
.no-match { display: none; padding: 20px 16px; color: var(--text-dim); text-align: center; }
footer { margin-top: 24px; font-size: 12px; color: var(--text-dim); display: flex; justify-content: space-between;
  flex-wrap: wrap; gap: 8px; }
@media (max-width: 900px) {
  .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .page { padding: 20px 16px 32px; }
  .meta { grid-template-columns: auto; }
}
@media print {
  body { background: #fff; }
  .tools { display: none; }
  .card, .tile, .verdict { break-inside: avoid; }
}
</style>
</head>
<body>
<div class="page">
  <header class="top">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 6h9M4 12h9M4 18h6"/>
          <path class="hl" d="M15 15.5l2.5 2.5L21 13" stroke="currentColor"/>
        </svg>
      </div>
      <div>
        <div class="eyebrow">iolistgen · отчёт проверки</div>
        <h1>{{ ctx.title }}</h1>
      </div>
    </div>
    <dl class="meta">
      <dt>Файл</dt><dd class="mono">{{ ctx.file_name }}{% if ctx.sheet %} · лист «{{ ctx.sheet }}»{% endif %}</dd>
      <dt>SHA-256</dt><dd class="mono" title="{{ ctx.sha256 }}">{{ ctx.sha_short }}</dd>
      <dt>Настройки</dt><dd class="mono">{{ ctx.config }}</dd>
      <dt>iolistgen</dt><dd class="mono">{{ ctx.version }}</dd>
    </dl>
  </header>

  {% if ctx.ok %}
  <section class="verdict verdict--ok" aria-label="Итог проверки">
    <div class="verdict-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
    </div>
    <div>
      <h2>Перечень прошёл проверку: {{ ctx.summary }}</h2>
      <p>Можно генерировать код и документацию: <span class="mono">iolistgen generate {{ ctx.file_name }} --out &lt;каталог&gt;</span></p>
    </div>
  </section>
  {% else %}
  <section class="verdict verdict--fail" aria-label="Итог проверки">
    <div class="verdict-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 7v6"/><path d="M12 17h.01"/></svg>
    </div>
    <div>
      <h2>Найдено: {{ ctx.summary }}</h2>
      <p>Генерация кода невозможна, пока в перечне есть ошибки. У каждого сообщения — место в файле и способ исправления.</p>
    </div>
  </section>
  {% endif %}

  <section class="kpis" aria-label="Сводка">
    <div class="tile">
      <div class="tile-label">Сигналов</div>
      <div class="tile-value">{{ ctx.signals }}</div>
      <div class="tile-note">строк перечня</div>
    </div>
    <div class="tile">
      <div class="tile-label">Устройств</div>
      <div class="tile-value">{{ ctx.devices }}</div>
      <div class="tile-note">экземпляров ФБ библиотеки PL</div>
    </div>
    <div class="tile">
      <div class="tile-label">Сигналов Modbus</div>
      <div class="tile-value">{{ ctx.modbus }}</div>
      <div class="tile-note">с корректным адресом</div>
    </div>
    <div class="tile {{ 'tile--alarm' if ctx.errors else 'tile--ok' }}">
      <div class="tile-label"><span class="dot" aria-hidden="true"></span>Ошибок</div>
      <div class="tile-value">{{ ctx.errors }}</div>
      <div class="tile-note">{{ 'блокируют генерацию' if ctx.errors else 'генерация разрешена' }}</div>
    </div>
    <div class="tile {{ 'tile--warn' if ctx.warnings else 'tile--ok' }}">
      <div class="tile-label"><span class="dot" aria-hidden="true"></span>Предупреждений</div>
      <div class="tile-value">{{ ctx.warnings }}</div>
      <div class="tile-note">{{ 'стоит проверить' if ctx.warnings else 'нет' }}</div>
    </div>
  </section>

  {% if ctx.by_signal_type or ctx.by_device_type %}
  <section class="composition" aria-label="Состав перечня">
    {% if ctx.by_signal_type %}
    <div>Типы сигналов:
      {% for name, count in ctx.by_signal_type.items() %}<span class="chip">{{ name }} <b>{{ count }}</b></span>{% endfor %}
    </div>
    {% endif %}
    {% if ctx.by_device_type %}
    <div>Устройства:
      {% for name, count in ctx.by_device_type.items() %}<span class="chip">{{ name }} <b>{{ count }}</b></span>{% endfor %}
    </div>
    {% endif %}
  </section>
  {% endif %}

  <section class="card" aria-labelledby="diag-title">
    <div class="card-head">
      <h2 id="diag-title">Сообщения{% if ctx.rows %}<span class="count"><span id="shown">{{ ctx.rows|length }}</span> из {{ ctx.rows|length }}</span>{% endif %}</h2>
      {% if ctx.rows %}
      <div class="tools">
        <button class="filter" type="button" data-filter="all" aria-pressed="true">Все · {{ ctx.rows|length }}</button>
        <button class="filter" type="button" data-filter="error" aria-pressed="false">Ошибки · {{ ctx.errors }}</button>
        <button class="filter" type="button" data-filter="warning" aria-pressed="false">Предупреждения · {{ ctx.warnings }}</button>
        <input class="search" id="search" type="search" placeholder="Поиск: тег, код, текст" aria-label="Поиск по сообщениям">
      </div>
      {% endif %}
    </div>
    {% if ctx.rows %}
    <div class="table-wrap">
      <table id="diag">
        <thead>
          <tr><th>Уровень</th><th>Код</th><th>Место</th><th>Тег</th><th>Что не так и как исправить</th></tr>
        </thead>
        <tbody>
          {% for row in ctx.rows %}
          <tr data-severity="{{ row.severity }}" data-text="{{ (row.code ~ ' ' ~ row.tag ~ ' ' ~ row.device ~ ' ' ~ row.message ~ ' ' ~ row.hint ~ ' ' ~ row.location)|lower }}">
            <td>
              <span class="sev sev--{{ row.severity }}">
                {% if row.severity == 'error' %}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7.5v5.5"/><path d="M12 16.5h.01"/></svg>
                {% else %}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.5l9.5 16.5h-19z"/><path d="M12 10v4.5"/><path d="M12 17.5h.01"/></svg>
                {% endif %}
                {{ row.severity_title|capitalize }}
              </span>
            </td>
            <td><span class="code" title="{{ row.rule_title }}">{{ row.code }}</span></td>
            <td class="where">
              {% if row.row is not none %}строка <b>{{ row.row }}</b>{% else %}файл{% endif %}
              {% if row.column %}<span class="col" title="{{ row.header or '' }}">колонка {{ row.column }}{% if row.header %} · {{ row.header }}{% endif %}</span>{% endif %}
            </td>
            <td class="tag">{{ row.tag }}{% if row.device and row.device != row.tag %}<span class="dev">{{ row.device }}</span>{% endif %}</td>
            <td>
              <div class="msg">{{ row.message }}</div>
              {% if row.hint %}<div class="fix"><span class="fix-label">как исправить</span>{{ row.hint }}</div>{% endif %}
              {% if row.related %}<div class="rel">см. {{ row.related }}</div>{% endif %}
            </td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      <div class="no-match" id="no-match">Нет сообщений по этому фильтру.</div>
    </div>
    {% else %}
    <div class="empty">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
      <div>Сообщений нет: все проверки пройдены.</div>
    </div>
    {% endif %}
  </section>

  {% if ctx.rules %}
  <section class="card" aria-labelledby="rules-title">
    <div class="card-head"><h2 id="rules-title">Сработавшие правила<span class="count">{{ ctx.rules|length }}</span></h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Код</th><th>Уровень</th><th>Группа</th><th>Правило</th><th class="num">Сообщений</th></tr></thead>
        <tbody>
          {% for rule in ctx.rules %}
          <tr>
            <td><span class="code">{{ rule.code }}</span></td>
            <td><span class="sev sev--{{ rule.severity }}">{{ rule.severity_title|capitalize }}</span></td>
            <td>{{ rule.group }}</td>
            <td>{{ rule.title }}</td>
            <td class="num">{{ rule.count }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  <footer>
    <span>Схема перечня и все правила проверки: <span class="mono">iolistgen schema</span></span>
    <span class="mono">iolistgen {{ ctx.version }} · {{ ctx.format }} · SHA-256 {{ ctx.sha_short }}</span>
  </footer>
</div>
{% if ctx.rows %}
<script>
(function () {
  "use strict";
  var rows = Array.prototype.slice.call(document.querySelectorAll("#diag tbody tr"));
  var buttons = Array.prototype.slice.call(document.querySelectorAll(".filter"));
  var search = document.getElementById("search");
  var shown = document.getElementById("shown");
  var noMatch = document.getElementById("no-match");
  var state = "all";
  function apply() {
    var query = (search.value || "").toLowerCase().trim();
    var visible = 0;
    rows.forEach(function (row) {
      var ok = (state === "all" || row.getAttribute("data-severity") === state) &&
        (!query || row.getAttribute("data-text").indexOf(query) !== -1);
      row.hidden = !ok;
      if (ok) { visible += 1; }
    });
    shown.textContent = String(visible);
    noMatch.style.display = visible ? "none" : "block";
  }
  buttons.forEach(function (button) {
    button.addEventListener("click", function () {
      state = button.getAttribute("data-filter");
      buttons.forEach(function (other) { other.setAttribute("aria-pressed", String(other === button)); });
      apply();
    });
  });
  search.addEventListener("input", apply);
})();
</script>
{% endif %}
</body>
</html>
